# Track reviewed thread handoffs and inspector lists while keeping other local
# notes, raw logs, generated previews, and data artifacts ignored.
!/notes/
/notes/*
!/notes/CODEX_USAGE_TRANSPARENCY.md
!/notes/codex_proposals/
/notes/codex_proposals/*
!/notes/codex_proposals/THREAD1_REPOSITORY_MAP.md
